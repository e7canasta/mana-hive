// Decision on whether to implement or delete: SPEC-02 (canonical policy model).
// Do NOT delete this file without resolving the question it raises.

package com.manahive.contracts.policy

import com.manahive.contracts.common.Fingerprint
import com.manahive.contracts.scene.StateKind
import com.manahive.kernel.ResidentId
import com.manahive.kernel.RuleId
import io.kotest.core.spec.style.DescribeSpec
import io.kotest.matchers.collections.shouldHaveSize
import io.kotest.matchers.shouldBe
import io.kotest.matchers.shouldNotBe
import io.kotest.assertions.throwables.shouldThrow
import java.time.Duration

class PolicyPayloadDslSpec : DescribeSpec({

    val maria = ResidentId("maria")

    describe("buildCalibrationPayload") {
        it("builds calibration payload fluently") {
            val payload = buildCalibrationPayload(maria) {
                dwell(
                    StateKind.IN_BATHROOM,
                    warning = Duration.ofSeconds(20),
                    exceeded = Duration.ofSeconds(45),
                )
                confidence(StateKind.STANDING, 0.8)
            }

            payload.dwellThresholds.size shouldBe 1
            payload.confidence.minConfidence[StateKind.STANDING] shouldBe 0.8
            payload.fingerprint.value shouldNotBe ""
        }

        it("rejects invalid confidence") {
            shouldThrow<IllegalArgumentException> {
                buildCalibrationPayload(maria) {
                    confidence(StateKind.STANDING, 1.5)
                }
            }
        }

        it("rejects negative confidence") {
            shouldThrow<IllegalArgumentException> {
                buildCalibrationPayload(maria) {
                    confidence(StateKind.STANDING, -0.1)
                }
            }
        }

        it("rejects warning >= exceeded") {
            shouldThrow<IllegalArgumentException> {
                buildCalibrationPayload(maria) {
                    dwell(
                        StateKind.IN_BATHROOM,
                        warning = Duration.ofSeconds(45),
                        exceeded = Duration.ofSeconds(20),
                    )
                }
            }
        }

        it("rejects warning == exceeded") {
            shouldThrow<IllegalArgumentException> {
                buildCalibrationPayload(maria) {
                    dwell(
                        StateKind.IN_BATHROOM,
                        warning = Duration.ofSeconds(30),
                        exceeded = Duration.ofSeconds(30),
                    )
                }
            }
        }

        it("rejects negative hysteresis") {
            shouldThrow<IllegalArgumentException> {
                buildCalibrationPayload(maria) {
                    hysteresis(
                        StateKind.LYING,
                        StateKind.SITTING_IN_BED,
                        Duration.ofSeconds(-1),
                    )
                }
            }
        }

        it("rejects negative heartbeatTimeout") {
            shouldThrow<IllegalArgumentException> {
                buildCalibrationPayload(maria) {
                    heartbeatTimeout(Duration.ofSeconds(-1))
                }
            }
        }
    }

    describe("buildResponsePayload") {
        it("builds response payload fluently") {
            val payload = buildResponsePayload {
                rule(
                    id = RuleId("fall"),
                    trigger = StateKind.STANDING,
                    severity = Severity.CRITICAL,
                    closureCondition = ClosureCondition.STAFF_AND_SAFE,
                ) {
                    requiresNvr = true
                }
            }

            payload.rules shouldHaveSize 1
            payload.rules[0].id.value shouldBe "fall"
            payload.fingerprint.value shouldNotBe ""
        }

        it("builds multiple rules") {
            val payload = buildResponsePayload {
                rule(
                    id = RuleId("fall"),
                    trigger = StateKind.STANDING,
                    severity = Severity.CRITICAL,
                    closureCondition = ClosureCondition.STAFF_AND_SAFE,
                )
                rule(
                    id = RuleId("bathroom_dwell"),
                    trigger = StateKind.IN_BATHROOM,
                    severity = Severity.WARNING,
                    closureCondition = ClosureCondition.SAFE_ONLY,
                ) {
                    reversible = true
                }
            }

            payload.rules shouldHaveSize 2
        }
    }

    describe("buildEscalationPayload") {
        it("builds escalation payload fluently") {
            val payload = buildEscalationPayload {
                escalationDelay(Duration.ofMinutes(10))
                staffAssist(StaffAssistMode.OBLIGATORY)
                maxLevel(3)
            }

            payload.config.escalationDelay shouldBe Duration.ofMinutes(10)
            payload.config.staffAssist shouldBe StaffAssistMode.OBLIGATORY
            payload.config.maxLevel shouldBe 3
            payload.fingerprint.value shouldNotBe ""
        }

        it("rejects negative delay") {
            shouldThrow<IllegalArgumentException> {
                buildEscalationPayload {
                    escalationDelay(Duration.ofMinutes(-1))
                }
            }
        }

        it("rejects zero maxLevel") {
            shouldThrow<IllegalArgumentException> {
                buildEscalationPayload {
                    maxLevel(0)
                }
            }
        }
    }

    describe("buildRecordingPayload") {
        it("builds recording payload fluently") {
            val payload = buildRecordingPayload {
                enabled(true)
                preEventWindow(Duration.ofSeconds(30))
                postEventWindow(Duration.ofMinutes(2))
                quality(RecordingQuality.HIGH)
            }

            payload.config.enabled shouldBe true
            payload.config.preEventWindow shouldBe Duration.ofSeconds(30)
            payload.config.postEventWindow shouldBe Duration.ofMinutes(2)
            payload.config.quality shouldBe RecordingQuality.HIGH
            payload.fingerprint.value shouldNotBe ""
        }

        it("rejects negative preEventWindow") {
            shouldThrow<IllegalArgumentException> {
                buildRecordingPayload {
                    preEventWindow(Duration.ofSeconds(-1))
                }
            }
        }

        it("rejects negative postEventWindow") {
            shouldThrow<IllegalArgumentException> {
                buildRecordingPayload {
                    postEventWindow(Duration.ofSeconds(-1))
                }
            }
        }
    }
})
