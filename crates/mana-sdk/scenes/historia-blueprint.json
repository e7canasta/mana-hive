{
  "meta": {
    "id": "historia-blueprint",
    "title": "Blueprint de historia clinica",
    "description": "Incident ingestion, idempotency, reviews and lifecycle end-to-end",
    "requires_demo_seed": true
  },
  "context": "historia",
  "commands": [
    {
      "name": "login",
      "action": "login",
      "args": { "username": "admin", "password_default": "mana123" },
      "capture": "login"
    },
    {
      "name": "me",
      "action": "me",
      "args": {},
      "capture": "me",
      "assert": { "user.username": "admin" }
    },
    {
      "name": "crear facility",
      "action": "facilities.create",
      "args": { "name": "Hogar Historia", "timezone": "America/Argentina/Buenos_Aires" },
      "capture": "facility",
      "status": 201
    },
    {
      "name": "crear wing",
      "action": "wings.create",
      "args": { "facility_id": "{{facility.id}}", "name": "Ala Norte", "floor": "1" },
      "capture": "wing",
      "status": 201
    },
    {
      "name": "crear room",
      "action": "rooms.create",
      "args": { "wing_id": "{{wing.id}}", "number": "201", "type": "standard" },
      "capture": "room",
      "status": 201
    },
    {
      "name": "crear bed",
      "action": "beds.create",
      "args": { "room_id": "{{room.id}}", "label": "201-A" },
      "capture": "bed",
      "status": 201
    },
    {
      "name": "crear residente",
      "action": "residents.create",
      "args": { "full_name": "Incident Test Resident", "admission_date": "2025-01-15" },
      "capture": "resident",
      "status": 201
    },
    {
      "name": "asignar cama",
      "action": "residents.assignments.create",
      "args": { "resident_id": "{{resident.resident.id}}", "bed_id": "{{bed.id}}" },
      "capture": "assignment",
      "status": 201
    },
    {
      "name": "HIS-01 ingestar incidente",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/clinical/incidents",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_record_id": "sr-test-001",
          "resident_id": "{{resident.resident.id}}",
          "bed_id": "{{bed.id}}",
          "kind": "fall",
          "severity": "high",
          "occurred_at": "2026-08-18T03:12:44.000Z",
          "injury_status": "unknown",
          "source": "ai",
          "model_version": "v1"
        }
      },
      "capture": "ingest1",
      "status": 201,
      "assert": { "duplicate": false, "incident.detection.kind": "fall" }
    },
    {
      "name": "HIS-01 reingestar mismo source_record_id",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/clinical/incidents",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_record_id": "sr-test-001",
          "resident_id": "{{resident.resident.id}}",
          "kind": "fall",
          "severity": "high",
          "occurred_at": "2026-08-18T03:12:44.000Z",
          "injury_status": "unknown",
          "source": "ai",
          "model_version": "v1"
        }
      },
      "status": 200,
      "assert": { "duplicate": true }
    },
    {
      "name": "HIS-02 listar incidentes del residente",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/residents/{{resident.resident.id}}/incidents"
      },
      "assert": { "incidents.length": 1 }
    },
    {
      "name": "HIS-03 crear revision",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/incidents/{{ingest1.incident.id}}/reviews",
        "body": { "status": "under_review", "review_note": "Reviewing camera footage" }
      },
      "capture": "review1",
      "assert": { "incident.current.status": "under_review" }
    },
    {
      "name": "HIS-03 reabrir incidente",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/incidents/{{ingest1.incident.id}}/reviews",
        "body": { "status": "open", "review_note": "Need more evidence" }
      }
    },
    {
      "name": "HIS-03 cerrar con veredicto",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/incidents/{{ingest1.incident.id}}/reviews",
        "body": { "status": "closed", "detection_verdict": "not_a_fall", "review_note": "False alarm" }
      },
      "assert": { "incident.current.status": "closed", "incident.reviews.length": 3 }
    },
    {
      "name": "HIS-04 secuencia del incidente",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/incidents/{{ingest1.incident.id}}/sequence"
      },
      "assert": { "incident.reviews.length": 3 }
    },
    {
      "name": "HIS-05 segundo incidente",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/clinical/incidents",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_record_id": "sr-test-002",
          "resident_id": "{{resident.resident.id}}",
          "kind": "bed_exit",
          "severity": "medium",
          "occurred_at": "2026-08-18T04:00:00.000Z",
          "injury_status": "none",
          "source": "sensor",
          "model_version": "v1"
        }
      },
      "capture": "ingest2",
      "status": 201
    },
    {
      "name": "HIS-05 listar ambos incidentes",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/residents/{{resident.resident.id}}/incidents"
      },
      "assert": { "incidents.length": 2 }
    },
    {
      "name": "logout",
      "action": "logout",
      "args": {}
    }
  ]
}
