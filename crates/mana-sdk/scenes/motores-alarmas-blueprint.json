{
  "meta": {
    "id": "motores-alarmas-blueprint",
    "title": "Motor de alarmas: de evidencia a alerta",
    "description": "Una salida de cama configurada produce una alerta y un evento repetido no la duplica",
    "requires_demo_seed": true
  },
  "context": "motores-alarmas",
  "commands": [
    {
      "name": "login",
      "action": "login",
      "args": { "username": "admin", "password_default": "mana123" },
      "capture": "login"
    },
    {
      "name": "crear facility",
      "action": "facilities.create",
      "args": { "name": "Hogar Motor Alarmas", "timezone": "America/Argentina/Buenos_Aires" },
      "capture": "facility",
      "status": 201
    },
    {
      "name": "crear wing",
      "action": "wings.create",
      "args": { "facility_id": "{{facility.id}}", "name": "Ala Motor", "floor": "1" },
      "capture": "wing",
      "status": 201
    },
    {
      "name": "crear room",
      "action": "rooms.create",
      "args": { "wing_id": "{{wing.id}}", "number": "118", "type": "standard", "stream_key": "motor-118" },
      "capture": "room",
      "status": 201
    },
    {
      "name": "crear bed",
      "action": "beds.create",
      "args": { "room_id": "{{room.id}}", "label": "118-A", "monitor_key": "motor-camera-118" },
      "capture": "bed",
      "status": 201
    },
    {
      "name": "crear residente",
      "action": "residents.create",
      "args": { "full_name": "Motor Alarmas Test", "admission_date": "2025-03-01" },
      "capture": "resident",
      "status": 201
    },
    {
      "name": "asignar cama",
      "action": "residents.assignments.create",
      "args": { "resident_id": "{{resident.resident.id}}", "bed_id": "{{bed.id}}" },
      "capture": "assignment",
      "status": 201
    },
    {
      "name": "configurar nivel alto",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alarm-presets/{{resident.resident.id}}",
        "body": {
          "risk_level": "high",
          "mobility_aid": "none",
          "autopilot": false,
          "mode": "preset",
          "template_id": "balanced"
        }
      },
      "capture": "profile",
      "status": 200,
      "assert": { "preset.risk_level": "high" }
    },
    {
      "name": "MOT-AL-01 estado inicial en cama",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/events",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_event_id": "motor-alarmas-001",
          "monitor_key": "motor-camera-118",
          "kind": "state_change",
          "room_state": "occupied",
          "state": "laying_in_bed",
          "occurred_at": "2099-08-19T02:00:00.000Z"
        }
      },
      "status": 201,
      "assert": { "resolved": true, "alerts.length": 0 }
    },
    {
      "name": "MOT-AL-02 salida de cama crea alerta",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/events",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_event_id": "motor-alarmas-002",
          "monitor_key": "motor-camera-118",
          "kind": "state_change",
          "room_state": "occupied",
          "state": "standing",
          "occurred_at": "2099-08-19T02:01:00.000Z"
        }
      },
      "capture": "alert_event",
      "status": 201,
      "assert": { "alerts.length": 1, "alerts.0.rule_id": "bed_exit", "alerts.0.level": "high" }
    },
    {
      "name": "MOT-AL-02b alerta persistida en el SoR (system-of-record)",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alerts"
      },
      "status": 200,
      "assert": { "alerts.length": 1, "alerts.0.rule_id": "bed_exit", "alerts.0.level": "high", "alerts.0.status": "open" }
    },
    {
      "name": "MOT-AL-03 estado repetido no duplica",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/events",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_event_id": "motor-alarmas-003",
          "monitor_key": "motor-camera-118",
          "kind": "state_change",
          "room_state": "occupied",
          "state": "standing",
          "occurred_at": "2099-08-19T02:02:00.000Z"
        }
      },
      "status": 201,
      "assert": { "alerts.length": 0 }
    },
    {
      "name": "logout",
      "action": "logout",
      "args": {}
    }
  ]
}
