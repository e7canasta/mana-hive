{
  "meta": {
    "id": "politica-blueprint",
    "title": "Blueprint de politica de alarmas",
    "description": "Catalog, presets, profile updates, autopilot and recommendations end-to-end",
    "requires_demo_seed": true
  },
  "context": "politica",
  "commands": [
    {
      "name": "login",
      "action": "login",
      "args": { "username": "admin", "password_default": "mana123" },
      "capture": "login"
    },
    {
      "name": "me",
      "action": "me",
      "args": {},
      "capture": "me",
      "assert": { "user.username": "admin" }
    },
    {
      "name": "crear facility",
      "action": "facilities.create",
      "args": { "name": "Hogar Politica", "timezone": "America/Argentina/Buenos_Aires" },
      "capture": "facility",
      "status": 201
    },
    {
      "name": "crear wing",
      "action": "wings.create",
      "args": { "facility_id": "{{facility.id}}", "name": "Ala Norte", "floor": "1" },
      "capture": "wing",
      "status": 201
    },
    {
      "name": "crear room",
      "action": "rooms.create",
      "args": { "wing_id": "{{wing.id}}", "number": "301", "type": "standard" },
      "capture": "room",
      "status": 201
    },
    {
      "name": "crear bed",
      "action": "beds.create",
      "args": { "room_id": "{{room.id}}", "label": "301-A" },
      "capture": "bed",
      "status": 201
    },
    {
      "name": "crear residente",
      "action": "residents.create",
      "args": { "full_name": "Policy Test Resident", "admission_date": "2025-01-15" },
      "capture": "resident",
      "status": 201
    },
    {
      "name": "asignar cama",
      "action": "residents.assignments.create",
      "args": { "resident_id": "{{resident.resident.id}}", "bed_id": "{{bed.id}}" },
      "capture": "assignment",
      "status": 201
    },
    {
      "name": "POL-01 obtener catalogo",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alarm-presets/catalog"
      },
      "capture": "catalog",
      "assert": { "version": "2026.1", "transitions.length": 29, "levels.length": 3 }
    },
    {
      "name": "POL-01 buscar presets (el grupo tambien matchea)",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alarm-presets?q=fall"
      },
      "assert": { "transitions.length": 10 }
    },
    {
      "name": "POL-01 envelope de motores por residente",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alarm-presets"
      },
      "capture": "profiles0",
      "assert": {
        "profiles.length": 1,
        "profiles.0.profile.source": "default",
        "profiles.0.effective.level": "low",
        "profiles.0.recommendation.level": "low"
      }
    },
    {
      "name": "POL-02 perfil inicial es null",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alarm-presets/{{resident.resident.id}}"
      },
      "assert": { "preset": null, "profile.profile.source": "default", "profile.effective.level": "low" }
    },
    {
      "name": "POL-03 actualizar perfil",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alarm-presets/{{resident.resident.id}}",
        "body": {
          "risk_level": "high",
          "mobility_aid": "walker",
          "autopilot": true,
          "mode": "preset",
          "template_id": "night_wandering"
        }
      },
      "capture": "profile1",
      "assert": { "preset.risk_level": "high", "preset.mobility_aid": "walker", "preset.autopilot": true, "preset.mode": "preset", "profile.profile.risk_level": "high", "profile.effective.level": "high" }
    },
    {
      "name": "POL-03 verificar perfil actual",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alarm-presets/{{resident.resident.id}}"
      },
      "assert": { "preset.mobility_aid": "walker", "preset.autopilot": true, "preset.effective.level": "high", "preset.effective.rules.bed_exit.day": "alarm", "preset.effective.rules.out_of_bed_dwell.source": "template", "profile.recommendation.level": "low" }
    },
    {
      "name": "POL-04 actualizar perfil de nuevo",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alarm-presets/{{resident.resident.id}}",
        "body": {
          "risk_level": "low",
          "mobility_aid": "wheelchair",
          "mode": "custom",
          "overrides": { "bed_exit": { "night": "alarm" } }
        }
      },
      "capture": "profile2",
      "assert": { "preset.risk_level": "low", "preset.mobility_aid": "wheelchair", "preset.mode": "custom", "preset.effective.rules.bed_exit.night": "alarm", "preset.effective.rules.bed_exit.source": "custom", "profile.effective.rules.bed_exit.night": "alarm" }
    },
    {
      "name": "POL-05 historial de perfiles",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alarm-presets/{{resident.resident.id}}/history"
      },
      "assert": { "versions.length": 2 }
    },
    {
      "name": "POL-06 aplicar recomendacion individual",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alarm-presets/{{resident.resident.id}}/apply-recommendation",
        "body": {
          "risk_level": "medium",
          "template_id": "bathroom_assist",
          "catalog_version": "2026.1"
        }
      },
      "capture": "rec",
      "assert": { "preset.template_id": "bathroom_assist", "preset.risk_level": "medium" }
    },
    {
      "name": "POL-07 aplicar recomendaciones bulk",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alarm-presets/apply-recommendations",
        "body": {
          "recommendations": [
            {
              "resident_id": "{{resident.resident.id}}",
              "template_id": "balanced",
              "overrides_json": "{\"bed_exit\":{\"sensitivity\":\"high\"}}"
            }
          ]
        }
      },
      "assert": { "presets.length": 1, "profiles.length": 1, "profiles.0.recommendation.level": "low" }
    },
    {
      "name": "POL-08 autopilot",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alarm-presets/autopilot"
      },
      "assert": { "presets.length": 0, "profiles.length": 1, "profiles.0.autopilot_decision.action": "keep", "profiles.0.autopilot_decision.reason": "cooldown" }
    },
    {
      "name": "POL-09 desactivar autopilot global",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alarm-presets/autopilot",
        "body": { "enabled": false }
      },
      "assert": { "changed.length": 1, "profiles.0.profile.autopilot": false }
    },
    {
      "name": "logout",
      "action": "logout",
      "args": {}
    }
  ]
}
