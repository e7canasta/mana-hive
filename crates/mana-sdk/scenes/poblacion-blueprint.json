{
  "meta": {
    "id": "poblacion-blueprint",
    "title": "Blueprint de poblacion",
    "description": "POB-01..POB-06 end-to-end: padron de residentes, asignaciones, egreso y errores esperados, sobre estructura creada en la misma escena."
  },
  "contexto": "poblacion",
  "commands": [
    {
      "name": "login demo",
      "action": "login",
      "args": {
        "username": "admin",
        "password_default": "mana123"
      },
      "assert": {
        "user.username": "admin"
      }
    },
    {
      "name": "capturar el usuario logueado",
      "action": "me",
      "capture": "me",
      "assert": {
        "user.username": "admin"
      }
    },
    {
      "name": "estructura: facility",
      "action": "facilities.create",
      "capture": "facility",
      "args": {
        "name": "Manantial",
        "timezone": "UTC"
      },
      "status": 201
    },
    {
      "name": "estructura: ala norte",
      "action": "wings.create",
      "capture": "wing",
      "args": {
        "facility_id": "{{facility.id}}",
        "name": "Ala Norte",
        "floor": "1",
        "sort_order": 0
      },
      "status": 201
    },
    {
      "name": "estructura: habitacion 118",
      "action": "rooms.create",
      "capture": "room",
      "args": {
        "wing_id": "{{wing.id}}",
        "number": "118",
        "type": "single"
      },
      "status": 201
    },
    {
      "name": "estructura: cama 1 de 118",
      "action": "beds.create",
      "capture": "bed",
      "args": {
        "room_id": "{{room.id}}",
        "label": "Cama 1"
      },
      "status": 201
    },
    {
      "name": "estructura: cama 2 de 118",
      "action": "beds.create",
      "capture": "bed2",
      "args": {
        "room_id": "{{room.id}}",
        "label": "Cama 2"
      },
      "status": 201
    },
    {
      "name": "POB-01 alta de residente",
      "action": "residents.create",
      "capture": "residente",
      "args": {
        "full_name": "Josefa Molina",
        "external_id": "P-1001",
        "birth_date": "1938-04-12",
        "admission_date": "2025-01-15"
      },
      "status": 201,
      "assert": {
        "resident.full_name": "Josefa Molina",
        "resident.external_id": "P-1001",
        "resident.status": "active",
        "resident.birth_date": "1938-04-12"
      }
    },
    {
      "name": "POB-01 padron con un residente",
      "action": "residents.list",
      "assert": {
        "residents.length": 1,
        "residents.0.full_name": "Josefa Molina",
        "residents.0.status": "active"
      }
    },
    {
      "name": "POB-01 alta sin nombre",
      "action": "residents.create",
      "args": {},
      "status": 422
    },
    {
      "name": "POB-01 fecha invalida",
      "action": "residents.create",
      "args": {
        "full_name": "Ana Perez",
        "birth_date": "12-04-1938"
      },
      "status": 422
    },
    {
      "name": "POB-01 detalle de residente",
      "action": "residents.detail",
      "args": {
        "resident_id": "{{residente.resident.id}}"
      },
      "assert": {
        "resident.id": "{{residente.resident.id}}",
        "resident.status": "active"
      }
    },
    {
      "name": "POB-01 detalle inexistente",
      "action": "residents.detail",
      "args": {
        "resident_id": "no-existe"
      },
      "status": 404
    },
    {
      "name": "POB-01 actualizar residente",
      "action": "residents.update",
      "args": {
        "resident_id": "{{residente.resident.id}}",
        "full_name": "Josefa Molina R."
      },
      "assert": {
        "resident.full_name": "Josefa Molina R."
      }
    },
    {
      "name": "POB-02 asignar cama",
      "action": "residents.assignments.create",
      "capture": "asignacion",
      "args": {
        "resident_id": "{{residente.resident.id}}",
        "bed_id": "{{bed.id}}"
      },
      "status": 201,
      "assert": {
        "assignment.bed_id": "{{bed.id}}",
        "assignment.ends_at": null
      }
    },
    {
      "name": "POB-02 padron con cama",
      "action": "residents.list",
      "assert": {
        "residents.length": 1,
        "residents.0.bed_id": "{{bed.id}}",
        "residents.0.room.id": "{{room.id}}",
        "residents.0.room.number": "118",
        "residents.0.room.wing_name": "Ala Norte"
      }
    },
    {
      "name": "POB-02 historial de asignaciones",
      "action": "residents.assignments.list",
      "args": {
        "resident_id": "{{residente.resident.id}}"
      },
      "assert": {
        "assignments.length": 1,
        "assignments.0.id": "{{asignacion.assignment.id}}"
      }
    },
    {
      "name": "POB-02 reasignar cierra la anterior",
      "action": "residents.assignments.create",
      "capture": "asignacion2",
      "args": {
        "resident_id": "{{residente.resident.id}}",
        "bed_id": "{{bed2.id}}"
      },
      "status": 201,
      "assert": {
        "assignment.bed_id": "{{bed2.id}}"
      }
    },
    {
      "name": "POB-02 historial con dos asignaciones",
      "action": "residents.assignments.list",
      "args": {
        "resident_id": "{{residente.resident.id}}"
      },
      "assert": {
        "assignments.length": 2
      }
    },
    {
      "name": "POB-02 cama liberada",
      "action": "beds.assignment.delete",
      "args": {
        "bed_id": "{{bed.id}}"
      },
      "status": 409
    },
    {
      "name": "POB-02 asignar a cama inexistente",
      "action": "residents.assignments.create",
      "args": {
        "resident_id": "{{residente.resident.id}}",
        "bed_id": "cama-fantasma"
      },
      "status": 404
    },
    {
      "name": "POB-04 egreso",
      "action": "residents.discharge",
      "capture": "egreso",
      "args": {
        "resident_id": "{{residente.resident.id}}",
        "discharged_at": "2025-02-01"
      },
      "assert": {
        "resident.status": "discharged",
        "resident.discharged_at": "2025-02-01",
        "resident.discharged_by": "{{me.user.id}}"
      }
    },
    {
      "name": "POB-04 egreso cierra la asignacion abierta",
      "action": "beds.assignment.delete",
      "args": {
        "bed_id": "{{bed2.id}}"
      },
      "status": 409
    },
    {
      "name": "POB-04 egreso de egresado",
      "action": "residents.discharge",
      "args": {
        "resident_id": "{{residente.resident.id}}"
      },
      "status": 409
    },
    {
      "name": "POB-05 egreso antes del alta",
      "action": "residents.create",
      "capture": "residente2",
      "args": {
        "full_name": "Rosa Silva",
        "admission_date": "2025-03-10"
      },
      "status": 201
    },
    {
      "name": "POB-05 egreso antes del alta falla",
      "action": "residents.discharge",
      "args": {
        "resident_id": "{{residente2.resident.id}}",
        "discharged_at": "2025-01-01"
      },
      "status": 422
    },
    {
      "name": "auditoria de poblacion",
      "action": "audit.list",
      "args": {
        "action": "resident.created"
      },
      "assert": {
        "audit.length": 2
      }
    },
    {
      "name": "logout",
      "action": "logout",
      "status": 204
    }
  ]
}
