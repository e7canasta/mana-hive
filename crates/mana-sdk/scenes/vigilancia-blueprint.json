{
  "meta": {
    "id": "vigilancia-blueprint",
    "title": "Blueprint de vigilancia de alertas",
    "description": "Alert lifecycle, transitions, deliveries and escalation end-to-end",
    "requires_demo_seed": true
  },
  "context": "vigilancia",
  "commands": [
    {
      "name": "login",
      "action": "login",
      "args": { "username": "admin", "password_default": "mana123" },
      "capture": "login"
    },
    {
      "name": "me",
      "action": "me",
      "args": {},
      "capture": "me",
      "assert": { "user.username": "admin" }
    },
    {
      "name": "crear facility",
      "action": "facilities.create",
      "args": { "name": "Hogar Vigilancia", "timezone": "America/Argentina/Buenos_Aires" },
      "capture": "facility",
      "status": 201
    },
    {
      "name": "crear wing",
      "action": "wings.create",
      "args": { "facility_id": "{{facility.id}}", "name": "Ala Norte", "floor": "1" },
      "capture": "wing",
      "status": 201
    },
    {
      "name": "crear room",
      "action": "rooms.create",
      "args": { "wing_id": "{{wing.id}}", "number": "301", "type": "standard" },
      "capture": "room",
      "status": 201
    },
    {
      "name": "crear bed",
      "action": "beds.create",
      "args": { "room_id": "{{room.id}}", "label": "301-A" },
      "capture": "bed",
      "status": 201
    },
    {
      "name": "crear residente",
      "action": "residents.create",
      "args": { "full_name": "Vigilancia Test Resident", "admission_date": "2025-01-15" },
      "capture": "resident",
      "status": 201
    },
    {
      "name": "asignar cama",
      "action": "residents.assignments.create",
      "args": { "resident_id": "{{resident.resident.id}}", "bed_id": "{{bed.id}}" },
      "capture": "assignment",
      "status": 201
    },
    {
      "name": "VIG-01 crear alerta",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alerts",
        "body": {
          "resident_id": "{{resident.resident.id}}",
          "bed_id": "{{bed.id}}",
          "evidence_kind": "sensor_event",
          "evidence_ref": "event-001",
          "rule_id": "bed_exit",
          "level": "high",
          "title": "Bed exit detected",
          "detail": "Resident left bed without assistance",
          "occurred_at": "2025-08-19T03:00:00.000Z"
        }
      },
      "capture": "alert",
      "status": 201,
      "assert": { "alert.status": "open", "alert.rule_id": "bed_exit", "alert.level": "high" }
    },
    {
      "name": "VIG-01 listar alertas",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alerts"
      },
      "assert": { "alerts.length": 1 }
    },
    {
      "name": "VIG-02 transicionar a acknowledged",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alerts/{{alert.alert.id}}",
        "body": {
          "to_status": "acknowledged"
        }
      },
      "capture": "alert_ack",
      "assert": { "alert.status": "acknowledged" }
    },
    {
      "name": "VIG-03 transicionar a attending",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alerts/{{alert.alert.id}}",
        "body": {
          "to_status": "attending"
        }
      },
      "assert": { "alert.status": "attending" }
    },
    {
      "name": "VIG-04 crear entrega de notificacion",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alerts/{{alert.alert.id}}/deliveries",
        "body": {
          "recipient_kind": "user",
          "recipient_id": "{{login.user.id}}",
          "channel": "push",
          "escalation_level": 0
        }
      },
      "capture": "delivery",
      "status": 201,
      "assert": { "delivery.recipient_kind": "user", "delivery.channel": "push" }
    },
    {
      "name": "VIG-05 listar entregas",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alerts/{{alert.alert.id}}/deliveries"
      },
      "assert": { "deliveries.length": 1 }
    },
    {
      "name": "VIG-06 agregar evento sent a entrega",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/deliveries/{{delivery.delivery.id}}/events",
        "body": {
          "kind": "sent"
        }
      },
      "assert": { "delivery.events.length": 1 }
    },
    {
      "name": "VIG-07 view alert (audit access)",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alerts/{{alert.alert.id}}/view"
      },
      "assert": { "alert.id": "{{alert.alert.id}}" }
    },
    {
      "name": "VIG-08 transicionar a resolved",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alerts/{{alert.alert.id}}",
        "body": {
          "to_status": "resolved"
        }
      },
      "assert": { "alert.status": "resolved" }
    },
    {
      "name": "VIG-09 crear segunda alerta (dwell window)",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alerts",
        "body": {
          "bed_id": "{{bed.id}}",
          "evidence_kind": "dwell_window",
          "rule_id": "prolonged_dwell",
          "level": "medium",
          "title": "Prolonged dwell in bathroom",
          "occurred_at": "2025-08-19T04:00:00.000Z"
        }
      },
      "capture": "alert2",
      "status": 201,
      "assert": { "alert.status": "open", "alert.evidence_kind": "dwell_window" }
    },
    {
      "name": "VIG-09 listar alertas (debe haber 2)",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alerts"
      },
      "assert": { "alerts.length": 2 }
    },
    {
      "name": "logout",
      "action": "logout",
      "args": {}
    }
  ]
}
