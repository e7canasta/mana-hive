{
  "meta": {
    "id": "streams-blueprint",
    "title": "Blueprint de streams",
    "description": "STR-01..STR-06: crear streams, asignar regiones, consultar tree con streams."
  },
  "contexto": "streams",
  "commands": [
    {
      "name": "login demo",
      "action": "login",
      "args": {
        "username": "admin",
        "password_default": "mana123"
      },
      "assert": {
        "user.username": "admin"
      }
    },
    {
      "name": "RES-01 crear facility para streams",
      "action": "facilities.create",
      "capture": "facility",
      "args": {
        "name": "Sanatorio Streams",
        "timezone": "UTC"
      },
      "status": 201
    },
    {
      "name": "RES-02 crear ala para streams",
      "action": "wings.create",
      "capture": "wing",
      "args": {
        "facility_id": "{{facility.id}}",
        "name": "Ala Camera",
        "floor": "1",
        "sort_order": 0
      },
      "status": 201
    },
    {
      "name": "RES-03 crear habitacion 101",
      "action": "rooms.create",
      "capture": "room",
      "args": {
        "wing_id": "{{wing.id}}",
        "number": "101",
        "type": "single",
        "stream_key": "cam-101"
      },
      "status": 201
    },
    {
      "name": "RES-03 crear habitacion 102",
      "action": "rooms.create",
      "capture": "room2",
      "args": {
        "wing_id": "{{wing.id}}",
        "number": "102",
        "type": "double"
      },
      "status": 201
    },
    {
      "name": "STR-01 crear stream para room 101",
      "action": "streams.create",
      "capture": "stream",
      "args": {
        "room_id": "{{room.id}}",
        "stream_key": "rtsp://192.168.1.101/stream",
        "name": "Camara 101"
      },
      "status": 201,
      "assert": {
        "room_id": "{{room.id}}",
        "stream_key": "rtsp://192.168.1.101/stream",
        "name": "Camara 101"
      }
    },
    {
      "name": "STR-01 crear stream para room 102",
      "action": "streams.create",
      "capture": "stream2",
      "args": {
        "room_id": "{{room2.id}}",
        "stream_key": "rtsp://192.168.1.102/stream",
        "name": "Camara 102"
      },
      "status": 201
    },
    {
      "name": "STR-02 asignar regiones a stream 101",
      "action": "streams.set-regions",
      "args": {
        "stream_id": "{{stream.id}}",
        "regions": [
          {
            "region_type": "bed",
            "points": [[0.1, 0.2], [0.5, 0.2], [0.5, 0.8], [0.1, 0.8]],
            "label": "Cama 101-A"
          },
          {
            "region_type": "hallway",
            "points": [[0.6, 0.1], [0.9, 0.1], [0.9, 0.9], [0.6, 0.9]],
            "label": "Pasillo 101"
          },
          {
            "region_type": "bathroom",
            "points": [[0.0, 0.85], [0.3, 0.85], [0.3, 1.0], [0.0, 1.0]],
            "label": "Banio 101"
          }
        ]
      },
      "status": 200,
      "assert": {
        "regions.length": 3
      }
    },
    {
      "name": "STR-02 asignar regiones a stream 102",
      "action": "streams.set-regions",
      "args": {
        "stream_id": "{{stream2.id}}",
        "regions": [
          {
            "region_type": "bed",
            "points": [[0.1, 0.2], [0.4, 0.2], [0.4, 0.8], [0.1, 0.8]],
            "label": "Cama 102-A"
          },
          {
            "region_type": "bed",
            "points": [[0.5, 0.2], [0.8, 0.2], [0.8, 0.8], [0.5, 0.8]],
            "label": "Cama 102-B"
          }
        ]
      },
      "status": 200,
      "assert": {
        "regions.length": 2
      }
    },
    {
      "name": "STR-03 listar streams de room 101",
      "action": "streams.list",
      "args": {
        "room_id": "{{room.id}}"
      },
      "status": 200,
      "assert": {
        "streams.length": 1,
        "streams.0.stream_key": "rtsp://192.168.1.101/stream"
      }
    },
    {
      "name": "STR-04 obtener stream por id",
      "action": "streams.get",
      "args": {
        "stream_id": "{{stream.id}}"
      },
      "status": 200,
      "assert": {
        "id": "{{stream.id}}",
        "name": "Camara 101"
      }
    },
    {
      "name": "STR-05 listar regiones del stream 101",
      "action": "streams.regions",
      "capture": "regions",
      "args": {
        "stream_id": "{{stream.id}}"
      },
      "status": 200,
      "assert": {
        "regions.length": 3
      }
    },
    {
      "name": "STR-06 actualizar una region",
      "action": "streams.update-region",
      "args": {
        "stream_id": "{{stream.id}}",
        "region_id": "{{regions.regions.0.id}}",
        "points": [[0.05, 0.15], [0.55, 0.15], [0.55, 0.85], [0.05, 0.85]],
        "label": "Region Actualizada"
      },
      "status": 200,
      "assert": {
        "stream_id": "{{stream.id}}"
      }
    },
    {
      "name": "STR-07 tree incluye streams",
      "action": "facilities.tree",
      "args": {
        "facility_id": "{{facility.id}}"
      },
      "status": 200,
      "assert": {
        "wings.0.rooms.0.streams.length": 1,
        "wings.0.rooms.0.streams.0.regions.length": 3
      }
    },
    {
      "name": "STR-ERR-01 stream duplicado",
      "action": "streams.create",
      "args": {
        "room_id": "{{room.id}}",
        "stream_key": "rtsp://192.168.1.101/stream",
        "name": "Duplicado"
      },
      "status": 409
    },
    {
      "name": "STR-ERR-02 region con menos de 3 puntos",
      "action": "streams.set-regions",
      "args": {
        "stream_id": "{{stream.id}}",
        "regions": [
          {
            "region_type": "bed",
            "points": [[0.1, 0.2], [0.5, 0.2]],
            "label": "Invalida"
          }
        ]
      },
      "status": 422
    },
    {
      "name": "STR-ERR-03 region_type invalido",
      "action": "streams.set-regions",
      "args": {
        "stream_id": "{{stream.id}}",
        "regions": [
          {
            "region_type": "invalid_type",
            "points": [[0.1, 0.2], [0.5, 0.2], [0.5, 0.8], [0.1, 0.8]],
            "label": "Invalida"
          }
        ]
      },
      "status": 422
    }
  ]
}
