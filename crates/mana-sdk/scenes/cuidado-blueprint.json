{
  "meta": {
    "id": "cuidado-blueprint",
    "title": "Blueprint de cuidado",
    "description": "Rounds and care notes end-to-end",
    "requires_demo_seed": true
  },
  "context": "cuidado",
  "commands": [
    {
      "name": "login",
      "action": "login",
      "args": { "username": "admin", "password_default": "mana123" },
      "capture": "login"
    },
    {
      "name": "me",
      "action": "me",
      "args": {},
      "capture": "me",
      "assert": { "user.username": "admin" }
    },
    {
      "name": "crear facility",
      "action": "facilities.create",
      "args": { "name": "Hogar Cuidado", "timezone": "America/Argentina/Buenos_Aires" },
      "capture": "facility",
      "status": 201
    },
    {
      "name": "crear wing",
      "action": "wings.create",
      "args": { "facility_id": "{{facility.id}}", "name": "Ala Este", "floor": "1" },
      "capture": "wing",
      "status": 201
    },
    {
      "name": "crear room",
      "action": "rooms.create",
      "args": { "wing_id": "{{wing.id}}", "number": "201", "type": "standard" },
      "capture": "room",
      "status": 201
    },
    {
      "name": "crear bed",
      "action": "beds.create",
      "args": { "room_id": "{{room.id}}", "label": "201-A" },
      "capture": "bed",
      "status": 201
    },
    {
      "name": "crear residente",
      "action": "residents.create",
      "args": { "full_name": "Maria Lopez" },
      "capture": "resident",
      "status": 201
    },
    {
      "name": "asignar cama",
      "action": "residents.assignments.create",
      "args": { "resident_id": "{{resident.resident.id}}", "bed_id": "{{bed.id}}" },
      "capture": "assign",
      "status": 201
    },
    {
      "name": "CUI-01 crear ronda",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/rounds",
        "body": { "wing_id": "{{wing.id}}" }
      },
      "capture": "round",
      "status": 201,
      "assert": { "round.status": "in_progress" }
    },
    {
      "name": "CUI-01 ronda actual",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/rounds/current?wing_id={{wing.id}}"
      },
      "assert": { "round.id": "{{round.round.id}}" }
    },
    {
      "name": "CUI-01 duplicada",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/rounds",
        "body": { "wing_id": "{{wing.id}}" }
      },
      "status": 409
    },
    {
      "name": "CUI-01 detalle de ronda",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/rounds/{{round.round.id}}"
      },
      "capture": "detail",
      "assert": { "round.status": "in_progress" }
    },
    {
      "name": "CUI-02 completar con pendientes",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/rounds/{{round.round.id}}",
        "body": { "status": "completed" }
      },
      "status": 409
    },
    {
      "name": "CUI-05 crear nota",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/residents/{{resident.resident.id}}/notes",
        "body": { "body": "Patient resting comfortably", "duration_min": 15 }
      },
      "capture": "note",
      "status": 201,
      "assert": { "note.body": "Patient resting comfortably", "note.kind": "general" }
    },
    {
      "name": "CUI-05 nota vacia",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/residents/{{resident.resident.id}}/notes",
        "body": { "body": "  " }
      },
      "status": 422
    },
    {
      "name": "CUI-06 listar notas",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/residents/{{resident.resident.id}}/notes"
      },
      "assert": { "notes.length": 1 }
    },
    {
      "name": "CUI-06 care summary",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/residents/{{resident.resident.id}}/care"
      }
    },
    {
      "name": "CUI-07 listar rondas",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/rounds?wing_id={{wing.id}}"
      },
      "assert": { "rounds.length": 1 }
    },
    {
      "name": "logout",
      "action": "logout",
      "args": {}
    }
  ]
}
