{
  "meta": {
    "id": "residencia-blueprint",
    "title": "Blueprint de residencia",
    "description": "RES-01..RES-08 end-to-end: estructura, planograma, privacidad, vistas globales y errores esperados."
  },
  "contexto": "residencia",
  "commands": [
    {
      "name": "login demo",
      "action": "login",
      "args": {
        "username": "admin",
        "password_default": "mana123"
      },
      "assert": {
        "user.username": "admin"
      }
    },
    {
      "name": "RES-01 crear facility",
      "action": "facilities.create",
      "capture": "facility",
      "args": {
        "name": "Manantial",
        "timezone": "UTC"
      },
      "status": 201,
      "assert": {
        "name": "Manantial",
        "timezone": "UTC"
      }
    },
    {
      "name": "RES-05 detalle facility",
      "action": "facilities.detail",
      "args": {
        "facility_id": "{{facility.id}}"
      },
      "assert": {
        "id": "{{facility.id}}",
        "wings.length": 0
      }
    },
    {
      "name": "RES-02 crear ala norte",
      "action": "wings.create",
      "capture": "wing",
      "args": {
        "facility_id": "{{facility.id}}",
        "name": "Ala Norte",
        "floor": "1",
        "sort_order": 0
      },
      "status": 201,
      "assert": {
        "name": "Ala Norte",
        "facility_id": "{{facility.id}}"
      }
    },
    {
      "name": "RES-02 crear ala sur",
      "action": "wings.create",
      "capture": "wing_sur",
      "args": {
        "facility_id": "{{facility.id}}",
        "name": "Ala Sur",
        "floor": "1",
        "sort_order": 1
      },
      "status": 201
    },
    {
      "name": "RES-03 crear habitacion 118",
      "action": "rooms.create",
      "capture": "room",
      "args": {
        "wing_id": "{{wing.id}}",
        "number": "118",
        "type": "single",
        "stream_key": "stream-118"
      },
      "status": 201,
      "assert": {
        "number": "118",
        "type": "single",
        "stream_key": "stream-118"
      }
    },
    {
      "name": "RES-03 crear habitacion 119",
      "action": "rooms.create",
      "capture": "room2",
      "args": {
        "wing_id": "{{wing.id}}",
        "number": "119",
        "type": "double"
      },
      "status": 201
    },
    {
      "name": "RES-03 habitacion en ala sur",
      "action": "rooms.create",
      "capture": "room_sur",
      "args": {
        "wing_id": "{{wing_sur.id}}",
        "number": "201",
        "type": "single"
      },
      "status": 201
    },
    {
      "name": "RES-05 listar habitaciones",
      "action": "rooms.list",
      "args": {
        "wing_id": "{{wing.id}}"
      },
      "assert": {
        "rooms.length": 2
      }
    },
    {
      "name": "RES-03 numero duplicado",
      "action": "rooms.create",
      "args": {
        "wing_id": "{{wing.id}}",
        "number": "118",
        "type": "single"
      },
      "status": 409
    },
    {
      "name": "RES-04 crear cama 1",
      "action": "beds.create",
      "capture": "bed",
      "args": {
        "room_id": "{{room.id}}",
        "label": "Cama 1",
        "monitor_key": "monitor-118-1"
      },
      "status": 201,
      "assert": {
        "label": "Cama 1",
        "monitor_key": "monitor-118-1"
      }
    },
    {
      "name": "RES-04 crear cama 2",
      "action": "beds.create",
      "args": {
        "room_id": "{{room.id}}",
        "label": "Cama 2"
      },
      "status": 201
    },
    {
      "name": "RES-05 listar camas de la room",
      "action": "beds.list",
      "args": {
        "room_id": "{{room.id}}"
      },
      "assert": {
        "beds.length": 2
      }
    },
    {
      "name": "RES-08 overview de camas",
      "action": "beds.all",
      "assert": {
        "beds.length": 2,
        "beds.0.wing_name": "Ala Norte",
        "beds.0.room_number": "118"
      }
    },
    {
      "name": "RES-08 alas con bed_count",
      "action": "wings.list",
      "assert": {
        "wings.length": 2,
        "wings.0.name": "Ala Norte",
        "wings.0.bed_count": 2
      }
    },
    {
      "name": "RES-06 planograma vacio",
      "action": "planogram.get",
      "args": {
        "wing_id": "{{wing.id}}"
      },
      "assert": {
        "wing_id": "{{wing.id}}",
        "placements.length": 0
      }
    },
    {
      "name": "RES-06 guardar planograma",
      "action": "planogram.save",
      "args": {
        "wing_id": "{{wing.id}}",
        "placements": [
          {
            "room_id": "{{room.id}}",
            "x": 0.5,
            "y": 0.25,
            "sort_order": 0
          },
          {
            "room_id": "{{room2.id}}",
            "x": 0.75,
            "y": 0.5,
            "sort_order": 1
          }
        ]
      },
      "assert": {
        "placements.length": 2,
        "placements.0.room_number": "118"
      }
    },
    {
      "name": "RES-06 planograma guardado",
      "action": "planogram.get",
      "args": {
        "wing_id": "{{wing.id}}"
      },
      "assert": {
        "placements.length": 2
      }
    },
    {
      "name": "RES-06 habitacion duplicada",
      "action": "planogram.save",
      "args": {
        "wing_id": "{{wing.id}}",
        "placements": [
          {
            "room_id": "{{room.id}}",
            "x": 0.1,
            "y": 0.1,
            "sort_order": 0
          },
          {
            "room_id": "{{room.id}}",
            "x": 0.2,
            "y": 0.2,
            "sort_order": 1
          }
        ]
      },
      "status": 409
    },
    {
      "name": "RES-06 habitacion de otro ala",
      "action": "planogram.save",
      "args": {
        "wing_id": "{{wing.id}}",
        "placements": [
          {
            "room_id": "{{room_sur.id}}",
            "x": 0.1,
            "y": 0.1,
            "sort_order": 0
          }
        ]
      },
      "status": 404
    },
    {
      "name": "RES-07 guardar privacidad",
      "action": "privacy.regions.save",
      "args": {
        "room_id": "{{room.id}}",
        "regions": [
          {
            "x": 0.1,
            "y": 0.1,
            "w": 0.2,
            "h": 0.2
          },
          {
            "x": 0.4,
            "y": 0.1,
            "w": 0.2,
            "h": 0.2
          }
        ]
      },
      "assert": {
        "room_id": "{{room.id}}",
        "regions.length": 2
      }
    },
    {
      "name": "RES-07 privacidad guardada",
      "action": "privacy.regions.get",
      "args": {
        "room_id": "{{room.id}}"
      },
      "assert": {
        "regions.length": 2
      }
    },
    {
      "name": "RES-07 region invalida",
      "action": "privacy.regions.save",
      "args": {
        "room_id": "{{room.id}}",
        "regions": [
          {
            "x": 0.9,
            "y": 0.9,
            "w": 0.5,
            "h": 0.5
          }
        ]
      },
      "status": 422
    },
    {
      "name": "auditoria de planograma",
      "action": "audit.list",
      "args": {
        "action": "planogram.updated"
      },
      "assert": {
        "audit.length": 1
      }
    },
    {
      "name": "logout",
      "action": "logout",
      "status": 204
    }
  ]
}