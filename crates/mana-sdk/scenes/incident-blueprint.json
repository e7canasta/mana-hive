{
  "meta": {
    "id": "incident-blueprint",
    "title": "Blueprint de gestión de incidentes",
    "description": "Flujo completo de incidentes: creación, tracking de staff, timeline y cierre",
    "requires_demo_seed": true
  },
  "context": "incidentes",
  "commands": [
    {
      "name": "login",
      "action": "login",
      "args": { "username": "admin", "password_default": "mana123" },
      "capture": "login"
    },
    {
      "name": "crear facility",
      "action": "facilities.create",
      "args": { "name": "Hogar Incidentes", "timezone": "America/Argentina/Buenos_Aires" },
      "capture": "facility",
      "status": 201
    },
    {
      "name": "crear wing",
      "action": "wings.create",
      "args": { "facility_id": "{{facility.id}}", "name": "Ala Norte", "floor": "1" },
      "capture": "wing",
      "status": 201
    },
    {
      "name": "crear room",
      "action": "rooms.create",
      "args": { "wing_id": "{{wing.id}}", "number": "401", "type": "standard" },
      "capture": "room",
      "status": 201
    },
    {
      "name": "crear bed",
      "action": "beds.create",
      "args": { "room_id": "{{room.id}}", "label": "401-A", "monitor_key": "mana-camera-401" },
      "capture": "bed",
      "status": 201
    },
    {
      "name": "crear residente",
      "action": "residents.create",
      "args": { "full_name": "Incident Test Resident", "admission_date": "2025-01-15" },
      "capture": "resident",
      "status": 201
    },
    {
      "name": "asignar cama",
      "action": "residents.assignments.create",
      "args": { "resident_id": "{{resident.resident.id}}", "bed_id": "{{bed.id}}" },
      "capture": "assignment",
      "status": 201
    },
    {
      "name": "INC-00 configurar perfil high (delay_minutes=0 para bed_exit)",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alarm-presets/{{resident.resident.id}}",
        "body": {
          "risk_level": "high",
          "autopilot": false
        }
      },
      "assert": { "preset.risk_level": "high" }
    },
    {
      "name": "INC-00b ingestar estado inicial (lying)",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/events",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_event_id": "evt-inc-000",
          "monitor_key": "mana-camera-401",
          "kind": "room_state",
          "state": "laying_in_bed",
          "sleeping": true,
          "occurred_at": "{{now-300}}"
        }
      },
      "status": 201,
      "assert": { "resolved": true }
    },
    {
      "name": "INC-01 ingestar evento de caida (standing desde lying)",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/events",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_event_id": "evt-inc-001",
          "monitor_key": "mana-camera-401",
          "kind": "room_state",
          "state": "standing",
          "sleeping": false,
          "occurred_at": "{{now}}"
        }
      },
      "status": 201,
      "assert": { "resolved": true, "alerts.length": 1, "alerts.0.rule_id": "bed_exit" }
    },
    {
      "name": "INC-02 ingestar evento de dwell",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/events",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_event_id": "evt-inc-002",
          "monitor_key": "mana-camera-401",
          "kind": "room_state",
          "state": "standing",
          "sleeping": false,
          "occurred_at": "{{now+360}}"
        }
      },
      "status": 201
    },
    {
      "name": "INC-03 verificar que se creó alerta",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alerts"
      },
      "capture": "alerts",
      "assert": { "alerts.length": 1, "alerts.0.status": "open" }
    },
    {
      "name": "INC-04 transicionar alerta a acknowledged",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alerts/{{alerts.alerts.0.id}}",
        "body": {
          "to_status": "acknowledged"
        }
      },
      "assert": { "alert.status": "acknowledged" }
    },
    {
      "name": "INC-05 transicionar a attending",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alerts/{{alerts.alerts.0.id}}",
        "body": {
          "to_status": "attending"
        }
      },
      "assert": { "alert.status": "attending" }
    },
    {
      "name": "INC-06 crear entrega de notificación",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alerts/{{alerts.alerts.0.id}}/deliveries",
        "body": {
          "recipient_kind": "user",
          "recipient_id": "{{login.user.id}}",
          "channel": "push",
          "escalation_level": 0
        }
      },
      "capture": "delivery",
      "status": 201,
      "assert": { "delivery.recipient_kind": "user", "delivery.channel": "push" }
    },
    {
      "name": "INC-07 agregar evento sent a entrega",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/deliveries/{{delivery.delivery.id}}/events",
        "body": {
          "kind": "sent"
        }
      },
      "assert": { "delivery.events.length": 1 }
    },
    {
      "name": "INC-08 agregar evento acknowledged a entrega",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/deliveries/{{delivery.delivery.id}}/events",
        "body": {
          "kind": "acknowledged"
        }
      },
      "assert": { "delivery.events.length": 2 }
    },
    {
      "name": "INC-09 transicionar a resolved",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alerts/{{alerts.alerts.0.id}}",
        "body": {
          "to_status": "resolved"
        }
      },
      "assert": { "alert.status": "resolved" }
    },
    {
      "name": "INC-10 verificar entrega final",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alerts/{{alerts.alerts.0.id}}/deliveries"
      },
      "assert": { "deliveries.length": 1, "deliveries.0.events.length": 2 }
    },
    {
      "name": "INC-11 ver alert resuelto via list",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alerts"
      },
      "assert": { "alerts.0.status": "resolved", "alerts.0.rule_id": "bed_exit" }
    },
    {
      "name": "INC-12 crear segunda alerta (dwell)",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alerts",
        "body": {
          "bed_id": "{{bed.id}}",
          "evidence_kind": "dwell_window",
          "rule_id": "dwell_exceeded",
          "level": "medium",
          "title": "Prolonged dwell standing",
          "occurred_at": "{{now}}"
        }
      },
      "status": 201,
      "assert": { "alert.status": "open", "alert.evidence_kind": "dwell_window" }
    },
    {
      "name": "INC-13 verificar que hay 2 alertas",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alerts"
      },
      "assert": { "alerts.length": 2 }
    },
    {
      "name": "INC-14 view alert (audit access)",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/api/v1/alerts/{{alerts.alerts.0.id}}/view"
      },
      "assert": { "alert.id": "{{alerts.alerts.0.id}}" }
    },
    {
      "name": "logout",
      "action": "logout",
      "args": {}
    }
  ]
}
