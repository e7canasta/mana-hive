{
  "meta": {
    "id": "motores-alarmas-reloj",
    "title": "Motor de alarmas: el reloj detecta la permanencia fuera de cama",
    "description": "Una salida de cama en el pasado y, sin eventos nuevos, el barrido (Tick) emite la alerta de permanencia out_of_bed_dwell",
    "requires_demo_seed": true
  },
  "context": "motores-alarmas",
  "commands": [
    {
      "name": "login",
      "action": "login",
      "args": { "username": "admin", "password_default": "mana123" },
      "capture": "login"
    },
    {
      "name": "crear facility",
      "action": "facilities.create",
      "args": { "name": "Hogar Motor Reloj", "timezone": "America/Argentina/Buenos_Aires" },
      "capture": "facility",
      "status": 201
    },
    {
      "name": "crear wing",
      "action": "wings.create",
      "args": { "facility_id": "{{facility.id}}", "name": "Ala Reloj", "floor": "1" },
      "capture": "wing",
      "status": 201
    },
    {
      "name": "crear room",
      "action": "rooms.create",
      "args": { "wing_id": "{{wing.id}}", "number": "219", "type": "standard", "stream_key": "reloj-219" },
      "capture": "room",
      "status": 201
    },
    {
      "name": "crear bed",
      "action": "beds.create",
      "args": { "room_id": "{{room.id}}", "label": "219-A", "monitor_key": "motor-camera-reloj" },
      "capture": "bed",
      "status": 201
    },
    {
      "name": "crear residente",
      "action": "residents.create",
      "args": { "full_name": "Motor Reloj Test", "admission_date": "2025-03-01" },
      "capture": "resident",
      "status": 201
    },
    {
      "name": "asignar cama",
      "action": "residents.assignments.create",
      "args": { "resident_id": "{{resident.resident.id}}", "bed_id": "{{bed.id}}" },
      "capture": "assignment",
      "status": 201
    },
    {
      "name": "configurar permanencia fuera de cama",
      "action": "custom",
      "args": {
        "method": "PATCH",
        "path": "/api/v1/alarm-presets/{{resident.resident.id}}",
        "body": {
          "risk_level": "high",
          "mobility_aid": "none",
          "autopilot": false,
          "mode": "custom",
          "template_id": "balanced",
          "overrides_json": "{\"out_of_bed_dwell\":{\"day\":\"alarm\",\"dwell_minutes\":1},\"bed_exit\":{\"day\":\"alarm\"}}"
        }
      },
      "capture": "profile",
      "status": 200,
      "assert": { "preset.risk_level": "high" }
    },
    {
      "name": "REL-01 estado en cama (en el pasado)",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/events",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_event_id": "reloj-001",
          "monitor_key": "motor-camera-reloj",
          "kind": "state_change",
          "room_state": "occupied",
          "state": "laying_in_bed",
          "occurred_at": "{{now-600}}"
        }
      },
      "status": 201,
      "assert": { "resolved": true, "alerts.length": 0 }
    },
    {
      "name": "REL-02 salida de cama (en el pasado)",
      "action": "custom",
      "args": {
        "method": "POST",
        "path": "/internal/v1/events",
        "headers": { "x-clinical-secret": "clinical-dev-secret" },
        "body": {
          "source_event_id": "reloj-002",
          "monitor_key": "motor-camera-reloj",
          "kind": "state_change",
          "room_state": "occupied",
          "state": "standing",
          "occurred_at": "{{now}}"
        }
      },
      "status": 201,
      "assert": { "alerts.length": 1, "alerts.0.rule_id": "bed_exit", "alerts.0.level": "high" }
    },
    {
      "name": "REL-03 esperar el barrido (Tick) sin eventos nuevos",
      "action": "sleep",
      "args": { "seconds": 66 }
    },
    {
      "name": "REL-04 el reloj emitió la permanencia out_of_bed_dwell",
      "action": "custom",
      "args": {
        "method": "GET",
        "path": "/api/v1/alerts"
      },
      "status": 200,
      "assert": { "alerts.length": 2, "alerts.0.rule_id": "out_of_bed_dwell", "alerts.1.rule_id": "bed_exit", "alerts.0.evidence_kind": "dwell_window" }
    },
    {
      "name": "logout",
      "action": "logout",
      "args": {}
    }
  ]
}
